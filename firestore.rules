rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // An admin is any signed-in user whose UID has a document in /admins.
    // Create that document manually in the Firebase console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /cv/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      // Lets the client check its own admin status; nobody can write via the API.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
